{
  // Type-check scope for `next build` only (see `typescript.tsconfigPath` in
  // next.config.mjs). It drops the Jest suites, which the "TypeScript & guards"
  // CI job still checks through tsconfig.json. With them in, the build's
  // "Linting and checking validity of types" phase ran past the 25-minute job
  // limit. `include` and `exclude` are spelled out because Next rewrites a
  // tsconfig that lacks them.
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "__tests__", "__mocks__", "tests"]
}
