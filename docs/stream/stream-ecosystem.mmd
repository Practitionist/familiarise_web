flowchart TB
    subgraph BIZ["Business Entities"]
        U1["Consultant + Consultee Pair"]
        WEB_I["Webinar Instance"]
        CLS_I["Class Instance"]
        PLAN["Webinar / Class Plan + Accepted Collaborators"]
        SLOT["AppointmentOccurrence (1:1 Meeting)"]
    end

    subgraph STREAM_CHAT["Stream Chat"]
        subgraph MSG["Channel Type: messaging"]
            DM["Canonical Human-Pair DM (dm-a-b / dmo-org-pair)"]
            COL_CH["Collaborator Thread (collab-webinar/class-planId)"]
        end
        subgraph TEAM["Channel Type: team"]
            WEB_CH["Webinar Channel (webinar-id)"]
            CLS_CH["Class Channel (class-id)"]
        end
    end

    subgraph STREAM_VIDEO["Stream Video (default Call Type)"]
        CALL["Isolated Occurrence Call (occurrence-uuid / -rBase36)"]
        subgraph REC["Recording Pipeline"]
            direction LR
            R1["RECORDING"] --> R2["PROCESSING"] --> R3["READY (Stream S3 14d)"]
            R2 --> RF["FAILED"]
            R3 -->|"transfer-recordings SigV4"| R5["AVAILABLE (Cloudflare R2)"]
        end
        CALL -->|"recording_started / stopped / ready / failed"| REC
    end

    subgraph INFRA["Control Plane & Webhooks"]
        TOK["Token Provider (iat + exp 1h TTL)"]
        HOOK["Asymmetric Webhooks (strict streamCallId end vs occurrence fallback)"]
    end

    U1 --> DM
    PLAN --> COL_CH
    WEB_I --> WEB_CH
    WEB_I --> DM
    CLS_I --> CLS_CH
    CLS_I --> DM
    SLOT --> CALL
    HOOK -.-> STREAM_VIDEO
    TOK -.-> STREAM_CHAT
    TOK -.-> STREAM_VIDEO
