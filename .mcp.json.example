{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0"]
    },
    "netlify": {
      "command": "npx",
      "args": ["-y", "@netlify/mcp@1.15.1"]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@modelcontextprotocol/sdk@1.32.1",
        "-p",
        "zod@3.25.76",
        "-p",
        "@supabase/mcp-server-supabase@0.8.1",
        "mcp-server-supabase",
        "--read-only",
        "--project-ref",
        "pzmbxqdgibfkhjwzeprf"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "<SUPABASE_ACCESS_TOKEN>"
      }
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v2.1.0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ]
    },
    "streamio": {
      "command": "npx",
      "args": ["-y", "unofficial-streamio-mcp-server@0.4.2"],
      "env": {
        "STREAM_API_KEY": "${STREAM_API_KEY}",
        "STREAM_API_SECRET": "${STREAM_API_SECRET}",
        "STREAM_MCP_READ_ONLY": "true"
      }
    },
    "betterstack": {
      "type": "http",
      "url": "https://mcp.betterstack.com"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
