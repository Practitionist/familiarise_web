# Connection string for Supabase database via connection pooling with Supavisor
DATABASE_URL=""
# Direct connection to Supabase database (used for migrations)
DIRECT_URL=""

# Facebook OAuth credentials for authentication
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# GitHub OAuth credentials for authentication
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google OAuth credentials for authentication
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret key for JWT token generation and verification
JWT_SECRET=""

# BetterAuth credentials
# 32+ character random secret for signing sessions (openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Canonical base URL of the deployment, e.g. https://familiarisenow.com
BETTER_AUTH_URL=""
# Comma-separated additional origins to trust for CORS (e.g. Netlify preview deploy URLs)
# Leave empty if all traffic comes from BETTER_AUTH_URL
BETTER_AUTH_TRUSTED_ORIGINS=""

# Public app URL used by the auth client and for building absolute URLs (e.g. referral links)
NEXT_PUBLIC_APP_URL=""

# Public Supabase anonymous key for client-side operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=""

# Test user ID for development/testing purposes
NEXT_PUBLIC_TEST_USERID=""

# Redis connection URL
REDIS_URL=""

# Resend API key for transactional email service
RESEND_API_KEY=""

# Razorpay API credentials for payment processing
RAZORPAY_KEY_ID=""
RAZORPAY_SECRET=""

# Stripe API credentials and configuration
STRIPE_API_KEY=""
STRIPE_API_VERSION=""
STRIPE_WEBHOOK_SECRET=""

# Stream API keys for real-time features
NEXT_PUBLIC_STREAM_API_KEY=""
STREAM_API_KEY=""
STREAM_API_SECRET=""
STREAM_SYNC_SECRET=""

# Upstash Redis credentials for caching/queue management
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""

# Sentry DSN for error monitoring
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Sentry auth token for CLI or integrations
SENTRY_AUTH_TOKEN=""

# Novu notification service credentials
# Server-only secret key from Novu dashboard (Settings > API Keys)
NOVU_SECRET_KEY=""
# Client-safe Application Identifier from Novu dashboard (Settings > API Keys)
NEXT_PUBLIC_NOVU_APP_ID=""

# Password used for all seeded users (only needed for local dev/testing)
SEED_PASSWORD="SeedPass123!"

# Development auth bypass - ONLY set to "true" for local development
# This bypasses authentication checks in document APIs for easier testing
# NEVER enable in production!
DEV_BYPASS_AUTH="false"

# Exposes developer-only UI affordances (e.g. "Force Join (dev)" on consultee
# appointment cards). Set to "true" only in local dev or trusted preview envs.
# Defaults to disabled — production must NEVER set this to "true".
NEXT_PUBLIC_ENABLE_DEV_TOOLS="false"

# Logo.dev API - company logo stickers for work experience (https://logo.dev)
NEXT_PUBLIC_LOGO_DEV_TOKEN=""

# PAN encryption key for consultant tax info (AES-256-GCM)
# Generate with: openssl rand -hex 32
PAN_ENCRYPTION_KEY=""
# Organization payout account encryption (AES-256-GCM)
# Generate with: openssl rand -hex 32
ORG_PAYOUT_ENCRYPTION_KEY=""

# Enterprise — consolidated-invoice rollup cron flag.
# When "true", the monthly consolidated-invoice cron rolls up children's
# unpaid OrganizationInvoice rows into a single parent-org invoice on the
# 1st of the month. Defaults to "false" because org hierarchy is still
# schema-only for most tenants; enable once a parent tenant requires
# consolidated billing. See app/api/cleanup/consolidated-invoice-rollup/.
ENABLE_CONSOLIDATED_INVOICE="false"
