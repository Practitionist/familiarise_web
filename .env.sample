# PostgreSQL Database Connection URLs
# Main connection URL with pgbouncer for connection pooling
DATABASE_URL="postgresql://postgres.[db_id]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL for migrations and other operations that require it
DIRECT_URL="postgresql://postgres.[db_id]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Authentication Providers Credentials
# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT and NextAuth Configuration
# Secret used to sign JWTs - should be a secure random string
JWT_SECRET=""
# Secret used by NextAuth.js - can be the same as JWT_SECRET
NEXTAUTH_SECRET=""
# The base URL of your site for NextAuth.js
NEXTAUTH_URL="http://localhost:3000"

# Supabase Configuration
# Public anon key for Supabase client-side operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL=""

# Testing Configuration
# Test user ID for development and testing purposes
NEXT_PUBLIC_TEST_USERID=""

# Email Service
# API key for Resend email service
RESEND_API_KEY=""

# Payment Processors
# Razorpay credentials
RAZORPAY_KEY_ID=""
RAZORPAY_SECRET=""

# Stripe credentials
STRIPE_API_KEY=""
STRIPE_API_VERSION="2024-06-20"
STRIPE_WEBHOOK_SECRET=""

# Stream Chat Integration
# Public Stream Chat API key for client-side operations
NEXT_PUBLIC_STREAM_API_KEY=""
# Stream Chat API key for server-side operations
STREAM_API_KEY=""
# Stream Chat API secret for server-side operations
STREAM_API_SECRET=""
# Stream Chat synchronization secret
STREAM_SYNC_SECRET=""

# Redis Configuration
# Upstash Redis REST API token
UPSTASH_REDIS_REST_TOKEN=""
# Upstash Redis REST API URL
UPSTASH_REDIS_REST_URL=""

# Error Monitoring with Sentry
# Sentry DSN for client-side error reporting
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry DSN for server-side error reporting
SENTRY_DSN=""
# Sentry authentication token for releases and deployment tracking
SENTRY_AUTH_TOKEN=""