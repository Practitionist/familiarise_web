# How to read this file. Copy it to .env and fill in the values. Every value below is a
# placeholder, never a real credential, and .env itself is not tracked by version control.
# Each variable has a one-line comment: what it is, which subsystem reads it, whether it is
# (required) or (optional), and whether it is a secret. (required) means the deployment
# misbehaves without it; (optional) only switches a feature on or tunes it. A commented
# `# KEY=` line is unset by default; an empty active line is a placeholder to fill in.
# Related variables sit together under one heading per group. The same groups, with where to
# get each non-obvious value, are in the README, section "Environment variables".
# REDIS_URL is not used: Upstash is reached over REST, so never set a TCP Redis URL on Netlify.

# ============================================================================
# 1. Database and Supabase
# ============================================================================

# Connection string for the Supabase database via connection pooling with Supavisor (required)
DATABASE_URL=""
# Direct connection to the Supabase database, used for migrations (required)
DIRECT_URL=""
# pg.Pool max clients per process (optional). Leave unset locally (pg default 10).
# Set to 1 on Netlify: 125 concurrent functions x 10 default clients would dwarf
# Supavisor's client cap.
PG_POOL_MAX=""
# Connection budget in ms (optional). Default 3000 at runtime, 30000 during the build.
# PG_CONNECT_TIMEOUT_MS=""
# Client-side query budget in ms (optional). Default 6000.
# PG_QUERY_TIMEOUT_MS=""
# Queries slower than this many ms are logged (optional). Default 500.
# PRISMA_SLOW_QUERY_MS=""
# Serializable allocation transaction budgets in ms (optional). Defaults 8000 and 30000.
# ALLOCATION_TX_MAX_WAIT_MS=""
# ALLOCATION_TX_TIMEOUT_MS=""
# Public Supabase project URL (required)
NEXT_PUBLIC_SUPABASE_URL=""
# Server-only Supabase service-role key for bucket admin and signed URLs, lib/supabase.ts (required, secret)
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket that holds organisation data exports (optional). Default "org-exports".
# SUPABASE_DATA_EXPORT_BUCKET=""

# ============================================================================
# 2. Authentication (Better Auth, OAuth, Turnstile)
# ============================================================================

# Public app URL used by the auth client and for absolute URLs such as referral links (required)
NEXT_PUBLIC_APP_URL=""
# Canonical base URL of the deployment, e.g. https://familiarisenow.com (required)
BETTER_AUTH_URL=""
# 32+ character random secret for signing sessions: openssl rand -base64 32 (required, secret).
# It also derives the key for emailed links (newsletter, unsubscribe, calendar, support); rotating it voids them.
BETTER_AUTH_SECRET=""
# Secret rotation list "id:secret,id:secret" (optional). The first entry signs; unset means BETTER_AUTH_SECRET is used.
# BETTER_AUTH_SECRETS=""
# Comma-separated additional origins to trust for CORS, e.g. Netlify preview URLs (optional).
# These are our OWN origins, never a customer's identity provider; SSO discovery runs at
# provider-registration time (lib/sso/oidc-discovery.ts).
BETTER_AUTH_TRUSTED_ORIGINS=""

# OAuth sign-in credentials; a provider appears only when both of its values are set (optional)
# GitHub OAuth app client id, read by authentication (optional, public identifier, not a secret)
GITHUB_CLIENT_ID=""
# GitHub OAuth app client secret, read by authentication (optional, secret)
GITHUB_CLIENT_SECRET=""
# Google OAuth client id, read by authentication (optional, public identifier, not a secret)
GOOGLE_CLIENT_ID=""
# Google OAuth client secret, read by authentication (optional, secret)
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile on sign-up, password-reset request and verification-code resend (optional).
# Set both or neither: with either unset the captcha is off and production logs one warning at boot.
# Cloudflare's public always-pass test keys for local use; production refuses any test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# AES-256-GCM key for customer SSO provider configs, lib/sso/secret-crypto.ts (required to register an SSO provider).
# A separate key from PAN_ENCRYPTION_KEY so rotating one never rewrites the other. openssl rand -hex 32.
AUTH_CONFIG_ENCRYPTION_KEY=""
# The old key, only while rotating, until scripts/rotate-sso-secret-key.ts has re-encrypted every row.
AUTH_CONFIG_ENCRYPTION_KEY_PREVIOUS=""

# ============================================================================
# 3. Payments (Razorpay and RazorpayX)
# ============================================================================

# Razorpay API credentials for checkout (required)
RAZORPAY_KEY_ID=""
# Client-safe Razorpay key id, inlined into the checkout bundle (required)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Razorpay API secret for checkout and refunds (required, secret)
RAZORPAY_SECRET=""
# Webhook signing secret from the Razorpay dashboard (required)
RAZORPAY_WEBHOOK_SECRET=""
# The previous webhook secret, only while a rotation is rolling out (optional).
# The route accepts a signature made with either value; delete it afterwards.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=""
# Lets a production build run on rzp_test_ keys (optional). Removed at the live-key cutover.
# RAZORPAY_ALLOW_TEST_KEYS_IN_PRODUCTION=""

# RazorpayX payout credentials (required for live payouts). Key id and secret fall back to the
# Razorpay pair when unset; the account number has no fallback.
# RazorpayX key id for payouts (required for live payouts, not a secret)
RAZORPAYX_KEY_ID=""
# RazorpayX key secret for payouts (required for live payouts, secret)
RAZORPAYX_KEY_SECRET=""
# RazorpayX current-account number that funds payouts (required for live payouts, sensitive)
RAZORPAYX_ACCOUNT_NUMBER=""
# Signing secret for RazorpayX payout and fund-account webhooks (required for live payouts, secret)
RAZORPAYX_WEBHOOK_SECRET=""
# The previous RazorpayX webhook secret, only while a rotation is rolling out (optional).
# RAZORPAYX_WEBHOOK_SECRET_PREVIOUS=""
# Static-IP HTTP proxy for every RazorpayX call; live keys refuse to call without it, e.g. http://user:pass@host:port (required for live payouts)
RAZORPAYX_EGRESS_PROXY_URL=""

# Payout and checkout switches (optional)
# Live payout kill switch (optional). Only the literal "true" lets RazorpayX disbursements go out.
# ENABLE_LIVE_PAYOUTS="false"
# Maker-checker approval on payouts (optional). Only the literal "false" turns it off.
# PAYOUT_MAKER_CHECKER_REQUIRED=""
# Instant payouts at or below this many paise are sent at once (optional). Default 2500000.
INSTANT_PAYOUT_AUTO_APPROVE_PAISE=""
# Saved cards at personal checkouts, only after Razorpay enables tokenisation (optional)
ENABLE_SAVED_CARDS="false"
# Razorpay's bank EMI block at the plan checkouts (optional)
ENABLE_CHECKOUT_EMI="false"

# ============================================================================
# 4. Tax, compliance and encryption
# ============================================================================

# GSTIN of the platform as principal supplier (required to issue tax invoices). The legal name,
# address and GST state come from lib/company.ts; the state must match the GSTIN's first two digits.
# Leave empty until the real GSTIN is issued: invoice minting then no-ops and the register healer fills the gap.
PLATFORM_GSTIN=""
# Letter of Undertaking for zero-rated exports (optional). Without both, exports are taxed at 18% IGST.
# PLATFORM_LUT_NUMBER=""
# PLATFORM_LUT_VALID_TILL is YYYY-MM-DD
# PLATFORM_LUT_VALID_TILL=""
# ClearTax e-invoicing (optional). The IRP uploader stays dormant until all of them and
# PLATFORM_GSTIN are set; the supplier GSTIN header is PLATFORM_GSTIN.
# CLEARTAX_API_KEY=""
# CLEARTAX_GSP_TOKEN=""
# "sandbox" (default) or "production"
# CLEARTAX_ENV="sandbox"
# Section 194-O gross withholding base (optional). Defaults on; "false" is shadow-only.
# ENABLE_TDS_194O_GROSS=""
# "LEGACY" selects the pre-194-O engine (optional). Default "194O".
# TDS_ENGINE=""
# Admin TDS dashboard and Form 26Q surfaces (optional)
# ENABLE_TDS_ADMIN_VIEW="false"

# AES-256-GCM key for consultant PAN: openssl rand -hex 32 (required, secret)
PAN_ENCRYPTION_KEY=""
# Salt for the pseudonym an erased user's rows keep (required in production: an erasure refuses to run without it).
# Rotating it changes only future pseudonyms. openssl rand -hex 32.
ERASURE_SALT=""

# ============================================================================
# 5. Video and chat (Stream)
# ============================================================================

# Stream public API key for the chat and video client (required, public, not a secret)
NEXT_PUBLIC_STREAM_API_KEY=""
# Stream API key for server calls, chat and video (required, not a secret)
STREAM_API_KEY=""
# Stream API secret that mints user tokens, chat and video (required, secret)
STREAM_API_SECRET=""
# Signs Stream webhooks (optional). Falls back to STREAM_API_SECRET when unset.
# STREAM_WEBHOOK_SECRET=""
# The previous webhook secret, only while a rotation is rolling out (optional).
# STREAM_WEBHOOK_SECRET_PREVIOUS=""
# Comma-separated Stream user ids the stream-sync job must never delete (optional).
# "system" and the support user are always protected.
# STREAM_SYNC_EXCLUDED_USERS=""

# ============================================================================
# 6. Email and notifications (Resend, Novu)
# ============================================================================

# Resend API key for transactional email and the retry worker (required, secret)
RESEND_API_KEY=""
# Signing secret of the Resend webhook endpoint, /api/webhooks/resend (required, secret)
RESEND_WEBHOOK_SECRET=""
# Pre-launch delivery guard (required before launch): unset or "allowlist" sends only to familiarisenow.com and EMAIL_ALLOWLIST; "live" at launch.
EMAIL_DELIVERY_MODE="allowlist"
# Extra recipients allowed in allowlist mode: comma-separated exact addresses or @domain entries.
EMAIL_ALLOWLIST=""

# Novu notification secret keys: production uses NOVU_PRODUCTION_KEY (required there),
# every other context uses NOVU_DEVELOPMENT_KEY.
# Novu secret key for non-production deploys, read by notifications (required there, secret)
NOVU_DEVELOPMENT_KEY=""
# Novu secret key for production, read by notifications (required there, secret)
NOVU_PRODUCTION_KEY=""
# Client-safe Application Identifier from the Novu dashboard (required)
NEXT_PUBLIC_NOVU_APP_ID=""

# ============================================================================
# 7. Storage (Cloudflare R2)
# ============================================================================

# Cloudflare R2 holds our copy of every recording and serves presigned playback (required).
# R2_S3_ENDPOINT is the full S3 endpoint URL; scope the token to this one bucket.
# R2 bucket for recording copies, read by video and recordings (required, not a secret)
R2_BUCKET=""
# R2 S3 endpoint URL, read by video and recordings (required, not a secret)
R2_S3_ENDPOINT=""
# R2 access key id, read by video and recordings (required, secret)
R2_ACCESS_KEY_ID=""
# R2 secret access key, read by video and recordings (required, secret)
R2_SECRET_ACCESS_KEY=""
# Private bucket for digital product files, on the same R2 credentials. CORS must allow PUT and GET from the app origins, with AllowedHeaders Content-Type and If-None-Match.
R2_DIGITAL_PRODUCTS_BUCKET=""

# ============================================================================
# 8. Observability (Sentry, Better Stack, alerts)
# ============================================================================

# Sentry DSN for error monitoring, also used by the ticker (required in production)
NEXT_PUBLIC_SENTRY_DSN=""
# Environment tag on every event, e.g. "production" or "preview" (required)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Server-side environment name for job metrics when the public one is unset (optional)
# SENTRY_ENVIRONMENT=""
# Branch tag stamped on client events at build time; Netlify sets BRANCH (optional)
# NEXT_PUBLIC_SENTRY_BRANCH=""
# Sentry endpoints, deployment-specific so a self-hosted or EU org can differ (optional)
SENTRY_API_URL="https://us.sentry.io"
SENTRY_WEB_URL="https://practitionist.sentry.io"
# Sentry org and project slugs, read at build time by withSentryConfig and at runtime by the triage lookup
SENTRY_ORG="practitionist"
SENTRY_PROJECT="familiarise_web"
# Sentry auth token for source-map upload and release calls (optional, secret). BUILD-TIME ONLY: the
# running app never reads it. Scope project:releases plus org:read. Without it production
# stack traces arrive minified.
SENTRY_AUTH_TOKEN=""
# Sentry auth token for the back-office triage lookup, lib/observability/sentry-issues.ts (optional).
# Scope event:read; runtime-only and a DIFFERENT token from SENTRY_AUTH_TOKEN above.
# Left commented on purpose: an EMPTY value switches the lookup on with a blank credential.
# SENTRY_API_TOKEN=""
# An Internal Integration token (Organization: Read) for the daily ingest canary and the 70% quota warning (stats_v2).
# Unset records the canary run as a config skip and pages nobody. Runtime-only, not SENTRY_AUTH_TOKEN.
# SENTRY_STATS_TOKEN=""
# Day of month the Sentry billing period starts (optional). Default 19.
# SENTRY_QUOTA_PERIOD_START_DAY="19"
# Monthly error quota of the plan (optional). Default 5000, the free Developer plan.
# SENTRY_ERROR_QUOTA="5000"
# Comma-separated job names whose runs also send an ingest-canary event (optional)
# SENTRY_INGEST_CANARY_JOBS=""
# Attach the acting user and org ids to Sentry events (optional). Only the literal "on" enables it.
# Set the NEXT_PUBLIC_ twin to "on" as well so client bundles stamp the server-derived token.
# With SENTRY_IDENTITY_SALT (32+ byte secret) user.id is hashed into a one-way virtual token
# before leaving the server (DPDP). See docs/observability/sentry/05-identity-and-triage.md.
SENTRY_IDENTITY_ENABLED="off"
NEXT_PUBLIC_SENTRY_IDENTITY_ENABLED="off"
# SENTRY_IDENTITY_SALT=""

# Better Stack Telemetry (logs) sink for operational events (optional). The SystemEvent row stays
# the source of truth; the sink is best-effort and needs the flag below plus both values.
ENABLE_BETTERSTACK_TELEMETRY="false"
# Better Stack Telemetry source token, read by observability (optional, secret)
BETTERSTACK_SOURCE_TOKEN=""
# Better Stack Telemetry ingest host, read by observability (optional, not a secret)
BETTERSTACK_INGEST_URL=""
# Better Stack Uptime API token for the health route and monitor sync (optional, secret)
# BETTERSTACK_API_KEY=""
# Better Stack heartbeat URL the cron ticker pings once per completed tick (optional, Functions
# scope, production only). Unset skips the ping; a missed ping is Better Stack's "did not run" alert.
# BETTERSTACK_HEARTBEAT_URL=""
# Better Stack heartbeat the daily ops digest pings after a successful send, or with /fail after a
# failed one (optional, production only; 24 h period, 3 h grace). Unset is recorded on the run row.
# BETTERSTACK_DIGEST_HEARTBEAT_URL=""

# Where the Sentry ingest canary emails when Sentry rejects errors or its stats read fails (optional).
# Defaults to the support mailbox. It cannot go through Sentry, so it uses a separate provider.
OBSERVABILITY_ALERT_EMAIL=""
# Slack incoming-webhook URL that mirrors ingest-canary and data-breach alerts (optional, secret)
SLACK_OPS_WEBHOOK_URL=""
# Fine-grained GitHub token (Contents: read, this repository only) for the ops digest's release-lag
# read of the compare API (optional, production only, secret). Unset records release lag as unknown, never a page.
# GITHUB_RELEASE_LAG_TOKEN=""

# ============================================================================
# 9. Infrastructure and jobs (Netlify ticker, Upstash, maintenance)
# ============================================================================

# Bearer token that gates every /api/cleanup/* route and the Netlify ticker,
# netlify/functions/cron-tick.mts (required in production, secret). openssl rand -hex 32.
CRON_SECRET=""
# Where the ticker POSTs (optional). Defaults to the deploy URL Netlify sets.
CRON_TICK_BASE_URL=""

# Upstash Redis for rate limits, maintenance edge state and short interactive mutexes (required).
# Production and previews share one database unless previews get their own pair of values.
# Upstash REST token for rate limits and locks (required, secret)
UPSTASH_REDIS_REST_TOKEN=""
# Upstash REST endpoint for rate limits and locks (required, not a secret)
UPSTASH_REDIS_REST_URL=""
# Upstash usage line in the daily ops digest, lib/observability/ops-digest.ts (optional). These are
# Upstash MANAGEMENT credentials, distinct from the per-database REST token. Unset reads "unknown".
UPSTASH_MANAGEMENT_API_KEY=""
UPSTASH_EMAIL=""
UPSTASH_DATABASE_ID=""
# Monthly COMMAND count to alarm against (free-tier cap 500000), not a dollar budget
UPSTASH_MONTHLY_COMMAND_CAP=""

# Bypass secret for maintenance mode when none is stored in Redis (optional, secret)
# MAINTENANCE_BYPASS_SECRET=""

# ============================================================================
# 10. Feature flags and product switches
# ============================================================================

# Booking-suspend stage of dunning (optional)
# ENABLE_DUNNING_SUSPEND="false"
# Host-capable organisations (optional)
# ENABLE_HOST_ORGS="false"
# Org-scoped rate-card resolution, "on" or "off" (optional)
# RATE_CARD_SCOPED_RESOLUTION=""
# Monthly consolidated-invoice rollup (optional). Defaults on; "false" opts a deploy out.
ENABLE_CONSOLIDATED_INVOICE="true"
# Developer-only UI such as "Force Join (dev)" (optional). Production must NEVER set "true".
NEXT_PUBLIC_ENABLE_DEV_TOOLS="false"
# Logo.dev token for company logo stickers on work experience (optional, public)
NEXT_PUBLIC_LOGO_DEV_TOKEN=""
# Directus CMS webhook secret (optional, secret). Without it /api/webhooks/directus answers 404.
# DIRECTUS_WEBHOOK_SECRET=""

# ============================================================================
# 11. Seed only
# ============================================================================

# Password used for all seeded users (LOCAL DEV / TEST ONLY: use a strong secret on any shared database)
SEED_PASSWORD=""
# Password for seeded ADMIN/STAFF accounts, required with SEED_WITH_STAFF=true (never committed; ask the lead)
SEED_OPERATOR_PASSWORD=
# "true" also seeds the staff accounts (optional)
# SEED_WITH_STAFF="false"
# Seed volume: small, medium or large (optional)
# SEED_MODE="small"
# Must equal the host in DATABASE_URL for the seed to run against a non-local database (required for those runs)
# SEED_TARGET_CONFIRM=""
# Rows per batch and progress-log interval (optional). Defaults 50 and 10.
# SEED_BATCH_SIZE="50"
# SEED_LOG_INTERVAL="10"

# ============================================================================
# 12. Build only
# ============================================================================

# "true" runs the bundle analyzer (optional)
# ANALYZE="false"
# "true" re-enables the type-check and lint passes on a Netlify build (optional)
# STRICT_BUILD="false"
# "true" skips the heavy build steps in CI's own Build job (optional)
# CI_LEAN_BUILD="false"
# "true" enforces the Content-Security-Policy instead of reporting only; read at build time (optional)
# ENABLE_CSP_ENFORCE="false"

# ============================================================================
# 13. Platform-provided (never set by hand)
# ============================================================================

# NODE_ENV, NEXT_PHASE, NEXT_RUNTIME: Node and Next.js.
# NETLIFY, CONTEXT, COMMIT_REF, DEPLOY_PRIME_URL, URL, BRANCH, AWS_REGION, AWS_LAMBDA_FUNCTION_MEMORY_SIZE: Netlify.
# VERCEL, VERCEL_URL, VERCEL_GIT_COMMIT_SHA, VERCEL_CRON_SECRET: Vercel.
# FLY_APP_NAME: Fly.
# CI, GITHUB_ACTIONS, GITHUB_OUTPUT, GITHUB_REPOSITORY: GitHub Actions.
# The deployed commit, inlined from COMMIT_REF or VERCEL_GIT_COMMIT_SHA.
# BUILD_SHA=""
