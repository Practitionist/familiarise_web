//////////////////////////////////////////////////// THREE-LEDGER DISCIPLINE ////////////////////////////////////////////////////
// Usage / Funding / Settlement ledgers. Immutable rows; reconciliation lives
// in cron jobs not shipped in v1 — see docs/enterprise/18-three-ledger-
// discipline.md for the invariants.

model UsageLedgerEntry {
  id                  String  @id @default(uuid())
  programAssignmentId String?
  membershipId        String
  paymentId           String?
  /// Signed engagement count (negative on reversal entries). Sum across
  /// the period must equal ProgramAssignment.engagementsUsed — the
  /// reconcile cron asserts this invariant nightly.
  engagementsConsumed Int
  minutesConsumed     Int?
  priceAtBookingPaise Int
  wasOverage          Boolean @default(false)
  notes               String?

  createdAt DateTime @default(now())

  @@index([membershipId, createdAt])
  @@index([programAssignmentId, createdAt])
}

// FundingLedgerEntry is deliberately distinct from WalletEntry even
// though most rows are 1:1 paired (joined via `walletEntryId @unique`).
// They have different audiences and retention rules:
//
//   WalletEntry           — user-facing dashboard history. Carries
//                           gateway idempotency keys (`providerOrderId`,
//                           `providerPaymentId`) and is what the org's
//                           billing tab queries. Mutable enum
//                           `WalletReason` is product-friendly.
//   FundingLedgerEntry    — formal accounting twin. Carries
//                           `balanceAfterPaise` for point-in-time audit
//                           and the GRANT-only row type — platform-side
//                           awards (promotional credits, support
//                           comps, migration backfill) that have NO
//                           corresponding WalletEntry. Finance reads
//                           this; product never does.
//
// The reconciliation cron asserts:
//   sum(WalletEntry.deltaPaise where billingAccountId=X)
//     == BillingAccount.walletBalance (X)
//   sum(FundingLedgerEntry.deltaPaise where billingAccountId=X)
//     == BillingAccount.walletBalance (X)
//
// Don't merge into one table on the assumption "they're duplicates" —
// the GRANT carve-out + the audience separation justifies the second
// table. If grants are eventually exposed to users, the merge becomes
// viable; track that under the "redundancies" follow-up issue.
model FundingLedgerEntry {
  id                String        @id @default(uuid())
  billingAccountId  String
  deltaPaise        Int // signed
  /// Currency of `deltaPaise`. Today every BillingAccount is INR and the
  /// invariant "sum(deltaPaise) == walletBalance" assumes a single currency
  /// per account. Once multi-currency wallets land (see issue #711 and
  /// docs/payments/multi-currency/), the reconciler's invariant will need
  /// a per-currency split. The column ships now so the historical writes
  /// have the metadata when that day comes.
  currency          Currency      @default(INR)
  reason            FundingReason
  balanceAfterPaise Int
  paymentId         String?
  walletEntryId     String?       @unique
  notes             String?

  createdAt DateTime @default(now())

  @@index([billingAccountId, createdAt])
}

model SettlementLedgerEntry {
  id             String         @id @default(uuid())
  organizationId String?
  paymentId      String?
  invoiceId      String?
  payoutId       String?
  kind           SettlementKind
  amountPaise    Int // signed: + receive / - outflow
  currency       Currency
  notes          String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([kind, createdAt])
  // Reverse-lookup indexes used by the ledger reconciliation cron
  // (Phase 4) and by the admin "explain this payment / invoice / payout"
  // tools. Each FK column is sparse (nullable) so we keep them as
  // single-column indexes rather than composing them.
  @@index([paymentId])
  @@index([invoiceId])
  @@index([payoutId])
}

enum FundingReason {
  TOPUP
  BOOKING_DEBIT
  REFUND_CREDIT
  ADJUSTMENT
  GRANT
}

enum SettlementKind {
  INVOICE_ISSUED
  INVOICE_PAID
  PAYMENT_RECEIVED
  REFUND_ISSUED
  PAYOUT_SENT
  // Counter-entry written when a PAYOUT_SENT is reversed (admin cancel,
  // gateway failure reclaim). Carries the signed-positive amount that
  // nets the original -netPayout entry to zero for the cancelled window.
  PAYOUT_REVERSED
  CHARGEBACK
  CREDIT_NOTE
}

// Snapshot output of the ledger reconciliation auditor
// (`scripts/reconcile/reconcile-ledgers.ts`). Each run records per-scope
// findings so operators can diff between runs and page on regressions.
//
// The auditor is READ-ONLY: it never mutates the three ledgers
// (FundingLedgerEntry, WalletEntry-as-usage, SettlementLedgerEntry) or
// the derived balances (BillingAccount.walletBalance, OrganizationInvoice
// status). All remediation is manual — this table is the report, not the
// fix. See `docs/enterprise/18-three-ledger-discipline.md`.
model LedgerReconciliationReport {
  id            String   @id @default(uuid())
  runAt         DateTime @default(now())
  // "full" (all orgs / all billing accounts) or "org:<orgId>" for
  // scoped reruns triggered by an operator.
  scope         String
  // Aggregate totals surfaced at the top of the report, serialised as
  // JSON so we can add new metrics without a schema migration. Shape:
  //   {
  //     orgsChecked: number,
  //     accountsChecked: number,
  //     discrepanciesCount: number,
  //     totals: { funding: number, settlement: number, walletSum: number },
  //   }
  summary       Json
  // List of discrepancy objects. Each entry is a { orgId?, accountId?,
  // kind: "WALLET_BALANCE_DRIFT"|"SETTLEMENT_MISSING_INVOICE"|...,
  // expectedPaise, actualPaise, deltaPaise, details }. Empty array when
  // clean.
  findings      Json
  ok            Boolean
  // ms for the full reconcile run — useful for tracking whether the
  // auditor itself is getting slow enough to need partitioning.
  durationMs    Int
  // Optional: the membership id of the admin who triggered the run via
  // /api/admin/reconcile-ledgers, or null for the scheduled cron.
  triggeredById String?

  @@index([runAt])
  @@index([ok, runAt])
  @@map("ledger_reconciliation_reports")
}

