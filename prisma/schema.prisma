model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String    @db.Text
  isActive        Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  backgroundColor String?   @default("#000000")
  textColor       String?   @default("#FFFFFF")
  linkUrl         String?
  linkText        String?
