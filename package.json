{
  "name": "familiarise_web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && next build",
    "build:analyze": "ANALYZE=true npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:pull": "prisma db pull",
    "db:push": "npm run db:push:schema && npx tsx -r dotenv/config scripts/ci/check-db-sidecars.ts",
    "db:push:schema": "npm run db:preflight && prisma db push && npm run db:sidecars",
    "db:sidecars": "npx tsx -r dotenv/config scripts/db/apply-sidecars.ts --all",
    "db:recompute-ratings": "npx tsx -r dotenv/config scripts/db/recompute-consultant-ratings.ts",
    "db:preflight": "npx tsx -r dotenv/config scripts/db/preflight-push.ts",
    "novu:sync": "npx tsx -r dotenv/config scripts/novu/sync-workflows.ts",
    "novu:check": "npx tsx -r dotenv/config scripts/novu/sync-workflows.ts --check",
    "db:triggers": "npx tsx -r dotenv/config scripts/db/apply-sidecars.ts --ledger-triggers",
    "db:leg-triggers": "npx tsx -r dotenv/config scripts/db/apply-sidecars.ts --payment-legs-triggers",
    "db:constraints": "npx tsx -r dotenv/config scripts/db/apply-sidecars.ts --check-constraints",
    "test:chaos:api": "npx tsx tests/typescript/race-conditions/master-runner.ts sequential --category=07-real-api-booking && npx tsx tests/typescript/race-conditions/master-runner.ts sequential --category=09-webhook-storm",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:small": "SEED_MODE=small npx tsx prisma/seed.ts",
    "db:seed:medium": "SEED_MODE=medium npx tsx prisma/seed.ts",
    "db:seed:large": "SEED_MODE=large npx tsx prisma/seed.ts",
    "db:seed:validation": "npx tsx prisma/seedFiles/validation/impossible-cases.ts",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "email:dev": "email dev --dir emails",
    "fix:imports": "eslint --fix . --rule 'unused-imports/no-unused-imports: error'",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "knip": "npx --yes knip@5.88.1 --no-exit-code",
    "postinstall": "prisma generate",
    "scripts:analyze": "npm run build:analyze && npx tsx scripts/utils/analyze-bundle.ts",
    "scripts:test-bucket": "npx tsx tests/typescript/test-bucket-creation.ts",
    "scripts:cleanup-abandoned-payments": "npx tsx scripts/payments/cleanup-abandoned-payments.ts",
    "scripts:release-earnings": "npx tsx scripts/earnings/release-earnings.ts",
    "scripts:create-payout-batch": "npx tsx jobs/payouts/create-payout-batch.ts",
    "scripts:process-payouts": "npx tsx jobs/payouts/process-payouts.ts",
    "test:race": "npx tsx tests/typescript/race-conditions/master-runner.ts",
    "test:race:parallel": "npx tsx tests/typescript/race-conditions/master-runner.ts parallel",
    "scripts:stream-sync": "npx tsx jobs/stream/stream-sync.ts",
    "start": "next start",
    "start-watch": "WATCHPACK_POLLING=true next start",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/sso": "1.7.7",
    "@hookform/resolvers": "^5.9.1",
    "@novu/api": "^3.19.1",
    "@novu/nextjs": "^3.19.2",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.10.0",
