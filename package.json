    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.76.0",
    "@stream-io/node-sdk": "0.8.10",
    "@stream-io/video-react-sdk": "1.43.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bad-words": "^4.1.5",
    "bcrypt": "^6.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^11.18.2",
    "iso-639-1": "^3.1.6",
    "lucide-react": "^0.577.0",
    "next": "^15.5.27",
    "next-nprogress-bar": "^2.4.7",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "^18.3.1",
    "react-email": "6.11.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^2.15.4",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stream-chat": "9.53.0",
    "stream-chat-react": "14.12.1",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "^15.5.27",
    "@next/eslint-plugin-next": "^15.5.27",
    "@testing-library/jest-dom": "6.9.1",
    "@types/bad-words": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^3.23.2",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "liquidjs": "^10.30.0",
    "oauth2-mock-server": "9.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "better-call": {
      "zod": "$zod"
    },
    "postcss": "$postcss",
    "mysql2": "^3.24.5",
    "@hono/node-server": "^1.19.15",
    "valibot": "^1.5.0",
    "deepmerge-ts": "^8.0.2"
  }
}
