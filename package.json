    "@types/bcrypt": "^5.0.2",
    "@types/redlock": "^4.0.7",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.6",
    "axios": "^1.7.9",
    "bad-words": "^4.0.0",
