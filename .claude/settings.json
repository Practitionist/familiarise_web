{
  "permissions": {
    "ask": [
      "mcp__*supabase*__apply_migration",
      "mcp__*supabase*__create_branch",
      "mcp__*supabase*__create_project",
      "mcp__*supabase*__delete_branch",
      "mcp__*supabase*__deploy_edge_function",
      "mcp__*supabase*__merge_branch",
      "mcp__*supabase*__pause_project",
      "mcp__*supabase*__rebase_branch",
      "mcp__*supabase*__reset_branch",
      "mcp__*supabase*__restore_project"
    ],
    "deny": [
      "Bash(npx prisma* db push*)",
      "Bash(prisma db push*)",
      "Bash(npx prisma* migrate dev*)",
      "Bash(prisma migrate dev*)",
      "Bash(npx prisma* migrate reset*)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma* migrate deploy*)",
      "Bash(prisma migrate deploy*)",
      "Bash(node_modules/.bin/prisma migrate deploy*)",
      "Bash(npx prisma* migrate resolve*)",
      "Bash(prisma migrate resolve*)",
      "Bash(node_modules/.bin/prisma migrate resolve*)",
      "Bash(node_modules/.bin/prisma migrate reset*)",
      "Bash(*supabase.co*prisma*migrate*)",
      "Bash(*supabase.com*prisma*migrate*)",
      "Bash(npm * db:seed*)",
      "Bash(npm * db:recompute-ratings*)",
      "Bash(npm * db:studio*)",
      "Bash(*tsx *scripts/db/recompute-consultant-ratings*)",
      "Bash(*tsx *prisma/seed.ts*)",
      "Bash(npm run dev*)",
      "Bash(npx next dev*)",
      "Bash(next dev*)",
      "Bash(npm run build*)",
      "Bash(npx next build*)",
      "Bash(next build*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*supabase.*__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-sql-gate.ts\" || exit 2",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
